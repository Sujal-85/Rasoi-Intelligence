# Rasoi Intelligence — Environment Variables
# ============================================================
# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# ============================================================

# Your Supabase project URL (looks like https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (safe to use in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=
